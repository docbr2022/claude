# ==========================================
# FRONTEND (expostas ao navegador — prefixo VITE_)
# ==========================================
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica

# ==========================================
# NETLIFY FUNCTIONS (server-side, NUNCA exponha no frontend)
# Configure estas em: Netlify > Site settings > Environment variables
# ==========================================

# Supabase (acesso privilegiado usado só nas functions)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role

# Chave usada para criptografar/descriptografar as chaves salvas pelos usuários
# na tela de Configurações (AES-256-GCM). Gere uma com: openssl rand -hex 32
# NUNCA reutilize esta chave entre ambientes diferentes (dev/produção).
SETTINGS_ENCRYPTION_KEY=

# --- Tudo abaixo é OPCIONAL ---
# Estas chaves agora podem ser cadastradas direto pela tela "Configurações"
# dentro do app (ficam criptografadas no banco). As variáveis abaixo só
# funcionam como um fallback global, caso um usuário não tenha cadastrado a
# própria chave por lá.

# IA de texto e imagem (copies, prompts, briefing, landing pages, imagens)
# — Google Gemini, chave gerada no Google AI Studio (aistudio.google.com)
GOOGLE_API_KEY=AIza...

# WhatsApp — Meta Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=um-token-secreto-que-voce-inventa
WHATSAPP_BUSINESS_ACCOUNT_ID=
# UUID do usuário (auth.users.id no Supabase) dono do número de WhatsApp conectado.
# Usado pelo webhook para saber em qual conta salvar as mensagens recebidas.
WHATSAPP_OWNER_USER_ID=
